# Kopyala ve doldur:  cp .env.example .env
# .env ASLA commit edilmez.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Veritabanı modu ---
# Local (Docker): USE_AZURE_MYSQL=False
# Azure App Service: USE_AZURE_MYSQL=True
USE_AZURE_MYSQL=False

# --- Local Docker MySQL ---
DB_NAME=solgar
DB_USER=solgar_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_ROOT_PASSWORD=

# --- reCAPTCHA v3 (boş = devre dışı) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Azure AD SSO (App Registration gelince doldurulacak) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:8000/accounts/azure/callback/